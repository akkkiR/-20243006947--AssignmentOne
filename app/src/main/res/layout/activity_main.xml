<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/space_m"
            android:text="@string/welcome_title"
            android:textColor="@android:color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.55"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardFacilities"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/space_xs"
                android:layout_weight="1"
                android:addStatesFromChildren="true"
                android:background="@drawable/button_bg_selector"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <ImageButton
                    android:id="@+id/btnFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/facilities"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_facilities"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/facilities"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEvents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/space_xs"
                android:layout_weight="1"
                android:addStatesFromChildren="true"
                android:background="@drawable/button_bg_selector"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <ImageButton
                    android:id="@+id/btnEvents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/events"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_events"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/events"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardClubs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/space_xs"
                android:layout_weight="1"
                android:addStatesFromChildren="true"
                android:background="@drawable/button_bg_selector"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <ImageButton
                    android:id="@+id/btnClubs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/clubs"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_clubs"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/clubs"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- Support 卡片 增加id cardSupport -->
            <LinearLayout
                android:id="@+id/cardSupport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/space_xs"
                android:layout_weight="1"
                android:addStatesFromChildren="true"
                android:background="@drawable/button_bg_selector"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <ImageButton
                    android:id="@+id/btnSupport"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:contentDescription="@string/support"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_support"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/support"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
